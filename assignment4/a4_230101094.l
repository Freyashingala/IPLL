%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "y.tab.h" /* Generated by Bison, contains token definitions */

int line_no = 1;

void yyerror(const char *s);
%}

/* lexical grammar */
/* 3. Identifiers */
DIGIT               [0-9]
NONDIGIT            [_a-zA-Z]
IDENTIFIER          {NONDIGIT}({NONDIGIT}|{DIGIT})*

/* 4. Constants */
NONZERO-DIGIT       [1-9]
INTEGER-CONSTANT    {NONZERO-DIGIT}{DIGIT}*|0

DIGIT-SEQUENCE      {DIGIT}+
SIGN                [+-]
FRACTIONAL-CONSTANT ({DIGIT-SEQUENCE}?\.{DIGIT-SEQUENCE}|{DIGIT-SEQUENCE}\.)
FLOATING-CONSTANT   {FRACTIONAL-CONSTANT}

C-CHAR              ([^'\\\n]|{ESCAPE-SEQUENCE})
C-CHAR-SEQUENCE     {C-CHAR}+
CHARACTER-CONSTANT  \'{C-CHAR-SEQUENCE}\'
ESCAPE-SEQUENCE     \\[\'\"\?\\abfnrtv]

/* 5. String Literals */
S-CHAR              ([^\"\\\n]|{ESCAPE-SEQUENCE})
S-CHAR-SEQUENCE     {S-CHAR}*
STRING-LITERAL      \"{S-CHAR-SEQUENCE}\"

%%

 /* 7. Comments & Whitespace */
"/*"([^*]|\*+[^*/])*\*+"/" { 
    for(int i = 0; yytext[i] != '\0'; i++) {
        if(yytext[i] == '\n') line_no++;    
    }
}
"//".* { /* Ignore single-line comment */ }
\n       { line_no++; }
[ \t\r]+ { /* Ignore whitespace */ }

 /* 2. Keywords */
"void"          { return VOID; }
"char"          { return CHAR; }
"short"         { return SHORT; }
"int"           { return INT; }
"long"          { return LONG; }
"float"         { return FLOAT; }
"double"        { return DOUBLE; }
"signed"        { return SIGNED; }
"unsigned"      { return UNSIGNED; }
"_Bool"         { return BOOL; }
"static"        { return STATIC; }
"if"            { return IF; }
"else"          { return ELSE; }
"while"         { return WHILE; }
"do"            { return DO; }
"for"           { return FOR; }
"continue"      { return CONTINUE; }
"break"         { return BREAK; }
"return"        { return RETURN; }
"case"          { return CASE; }
"default"       { return DEFAULT; }

 /* 3, 4, 5. Identifiers, Constants, and Strings */
{IDENTIFIER}          { return IDENTIFIER; }
{INTEGER-CONSTANT}    { return CONSTANT; }
{FLOATING-CONSTANT}   { return CONSTANT; }
{CHARACTER-CONSTANT}  { return CONSTANT; }
{STRING-LITERAL}      { return STRING_LITERAL; }

 /* 6. Multi-character Punctuators */
"++"            { return INC_OP; }
"--"            { return DEC_OP; }
"<<"            { return LEFT_OP; }
">>"            { return RIGHT_OP; }
"<="            { return LE_OP; }
">="            { return GE_OP; }
"=="            { return EQ_OP; }
"!="            { return NE_OP; }
"&&"            { return AND_OP; }
"||"            { return OR_OP; }
"*="            { return MUL_ASSIGN; }
"/="            { return DIV_ASSIGN; }
"%="            { return MOD_ASSIGN; }
"+="            { return ADD_ASSIGN; }
"-="            { return SUB_ASSIGN; }
"<<="           { return LEFT_ASSIGN; }
">>="           { return RIGHT_ASSIGN; }
"&="            { return AND_ASSIGN; }
"^="            { return XOR_ASSIGN; }
"|="            { return OR_ASSIGN; }

 /* Single-character Punctuators (return as themselves) */
";"             { return ';'; }
"{"             { return '{'; }
"}"             { return '}'; }
","             { return ','; }
":"             { return ':'; }
"="             { return '='; }
"("             { return '('; }
")"             { return ')'; }
"["             { return '['; }
"]"             { return ']'; }
"."             { return '.'; }
"&"             { return '&'; }
"!"             { return '!'; }
"~"             { return '~'; }
"-"             { return '-'; }
"+"             { return '+'; }
"*"             { return '*'; }
"/"             { return '/'; }
"%"             { return '%'; }
"<"             { return '<'; }
">"             { return '>'; }
"^"             { return '^'; }
"|"             { return '|'; }
"?"             { return '?'; }

 /* Catch-all for unrecognized tokens */
.        { printf("Lexical Error: Unrecognized token '%s' at line %d\n", yytext, line_no); }

%%

int yywrap(void) {
    return 1;
}